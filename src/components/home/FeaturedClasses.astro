
---
const classes = [
  {
    number: "01",
    title: "Reformer Pilates",
    description:
      "Kontrollü hareketlerle bedenini güçlendirmeye ve hareket kabiliyetini geliştirmeye odaklan.",
    label: "GÜÇ VE DENGE",
    image: "/images/classes/reformer.jpg",
    alt: "Reformer Pilates ekipmanları ve stüdyo",
  },
  {
    number: "02",
    title: "Mat Pilates",
    description:
      "Kendi beden ağırlığını kullanarak merkez bölgeni güçlendirmeye ve esnekliğini geliştirmeye odaklan.",
    label: "ESNEKLİK VE KONTROL",
    image: "/images/classes/mat-pilates.jpg",
    alt: "Mat Pilates çalışma alanı",
  },
  {
    number: "03",
    title: "Özel Ders",
    description:
      "Kişisel hedeflerine ve ihtiyaçlarına göre şekillenen bireysel bir çalışma deneyimi.",
    label: "KİŞİSEL DENEYİM",
    image: "/images/classes/private.jpeg",
    alt: "Bireysel Pilates antrenmanı",
  },
];
---

<section class="classes-section" id="dersler">
  <div class="container">

    <div class="section-heading">
      <span class="eyebrow">HAREKETİNİ KEŞFET</span>

      <h2>
        Sana uygun bir başlangıç var.
      </h2>

      <p>
        Her bedenin ihtiyacı farklı. Kendine ayırdığın zamanı,
        sana uygun bir hareket deneyimiyle değerlendir.
      </p>
    </div>

    <div class="classes-grid">
      {classes.map((item) => (
        <article class="class-card">

          <div class="class-image-wrapper">
            <img
              src={item.image}
              alt={item.alt}
              class="class-image"
              loading="lazy"
            />

            <span class="class-number">
              {item.number}
            </span>

            <span class="image-label">
              {item.label}
            </span>
          </div>

          <div class="card-content">
            <h3>{item.title}</h3>

            <p>{item.description}</p>

            <a
              href="/iletisim/"
              aria-label={`${item.title} hakkında bilgi al`}
              class="card-link"
            >
              Bilgi Al
              <span aria-hidden="true">↗</span>
            </a>
          </div>

        </article>
      ))}
    </div>

    <div class="all-classes">
      <a href="/dersler/">
        Tüm dersleri keşfet
        <span aria-hidden="true">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .classes-section {
    padding: 110px 0;
    background: var(--color-background);
  }

  .section-heading {
    max-width: 650px;
    margin-bottom: 48px;
  }

  .eyebrow {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 16px 0;
    color: var(--color-deep-plum);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
  }

  .section-heading p {
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .classes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .class-card {
    overflow: hidden;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);

    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .class-card:hover {
    transform: translateY(-7px);
    box-shadow: var(--shadow-md);
  }

  /* Image */

  .class-image-wrapper {
    position: relative;
    height: 300px;
    overflow: hidden;
    background: var(--color-lavender);
  }

  .class-image {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 500ms ease;
  }

  .class-card:hover .class-image {
    transform: scale(1.06);
  }

  .class-number {
    position: absolute;
    top: 18px;
    left: 18px;

    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;
    border-radius: 50%;

    background: rgba(250, 249, 252, 0.92);
    color: var(--color-deep-plum);

    font-size: 0.85rem;
    font-weight: 700;
  }

  .image-label {
    position: absolute;
    bottom: 18px;
    left: 18px;

    padding: 9px 13px;
    border-radius: var(--radius-full);

    background: rgba(63, 49, 91, 0.85);
    color: white;

    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  /* Card Content */

  .card-content {
    padding: 28px;
  }

  .class-card h3 {
    margin-bottom: 12px;
    color: var(--color-deep-plum);
    font-size: 1.45rem;
    font-weight: 600;
  }

  .class-card p {
    min-height: 82px;
    margin-bottom: 22px;

    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: var(--color-primary);
    font-size: 0.95rem;
    font-weight: 700;

    transition: gap var(--transition-normal);
  }

  .card-link:hover {
    gap: 16px;
  }

  /* All Classes */

  .all-classes {
    margin-top: 42px;
    text-align: center;
  }

  .all-classes a {
    color: var(--color-deep-plum);
    font-weight: 700;
  }

  .all-classes a span {
    margin-left: 8px;
  }

  @media (max-width: 950px) {
    .classes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .classes-section {
      padding: 75px 0;
    }

    .classes-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .class-image-wrapper {
      height: 280px;
    }

    .class-card p {
      min-height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .class-card,
    .class-image,
    .card-link {
      transition: none;
    }

    .class-card:hover,
    .class-card:hover .class-image {
      transform: none;
    }
  }
</style>
